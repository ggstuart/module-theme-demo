// Settings for GitHub Codespaces (Code > Codespaces > Create codespace on main):
// a ready-made computer in the browser with Hugo installed.
{
  "name": "Module (Hugo)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.169.0",
      "extended": true
    }
  },
  // Fetch the theme, and install what the Learning Zone package build uses.
  "postCreateCommand": "git submodule update --init --recursive && sudo apt-get update -qq && sudo apt-get install -y -qq zip python3 >/dev/null",
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": { "label": "Website preview", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["yzhang.markdown-all-in-one", "budparr.language-hugo-vscode"]
    }
  }
}
